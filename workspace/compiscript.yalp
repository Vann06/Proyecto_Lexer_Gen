/* ============================================================
 * compiscript.yalp  -  Gramatica LALR para Compiscript (subconjunto)
 *
 * Traduccion ejecutable del subconjunto elegido de Compiscript.g4
 * (raiz del repo, gramatica ANTLR del Proyecto 2): let/var/const,
 * funciones con parametros y tipo de retorno, clases con herencia
 * simple/this/acceso a miembros (lectura y asignacion)/
 * instanciacion con new, bloques, el control de flujo completo
 * (if/while/do-while/for/foreach/switch/try-catch/break/continue/
 * return), print y la jerarquia completa de expresiones con
 * precedencia ( ||  &&  ==/!=  </<=/>/>=  +/-  * / %  unario - ! ),
 * y listas/arreglos (literal, indexado, multidimensional).
 *
 * Fuera de este subconjunto (siguiente iteracion): el operador
 * ternario.
 *
 * Dos ambiguedades de la .g4 original resueltas al traducir:
 *  - 'assignment' (Identifier '=' expr) duplicaba lo que ya cubre
 *    'assignmentExpr' via 'expressionStatement' — se conserva SOLO
 *    assign_stmt, igual que miniprog.yalp.
 *  - El dangling-else de ifStatement se resuelve con las 3
 *    alternativas explicitas de if_stmt (igual que miniprog.yalp),
 *    sin ambiguedad porque bloque siempre exige llaves.
 * ============================================================ */

%token LET VAR CONST FUNCTION CLASS IF ELSE WHILE BREAK CONTINUE RETURN PRINT
%token DO FOR SWITCH CASE DEFAULT FOREACH IN TRY CATCH
%token TRUE FALSE NULL_KW BOOL_T INT_T STR_T THIS NEW STRUCT
%token ID INT_LIT STR_LIT COMMENT
%token EQ NEQ LTE GTE AND OR
%token ASSIGN PLUS MINUS TIMES DIV MOD LT GT NOT
%token LPAREN RPAREN LBRACE RBRACE SEMI COMMA COLON DOT LBRACKET RBRACKET

/* Comentarios ignorados: el parser nunca los ve */
IGNORE COMMENT

/* ============================================================
 * Directivas de analisis semantico — declarativas, no hardcodeadas:
 * cualquier .yalp puede traer las suyas propias.
 * Ver semantico::spec::SemanticSpec::from_grammar.
 *
 * Fase 15 (ambito/tipos):
 * ============================================================ */
%ident   ID
%declare var_decl    variable
%declare const_decl  variable
%declare param       parameter
%declare func_decl   function
%declare class_decl  class
%declare struct_decl struct
%declare struct_field variable
%scope   func_decl   function
%scope   class_decl  class
%scope   struct_decl struct
%scope   bloque      block

/* ------------------------------------------------------------
 * Fase 15 (tipos, conectados al pipeline real): que hijo directo
 * de cada produccion es el nodo de tipo, y que Type representa
 * cada token de tipo primitivo/literal.
 * ------------------------------------------------------------ */
%type_of var_decl    tipo
%type_of const_decl  tipo
%type_of param       tipo
%type_of func_decl   tipo
%type_of struct_field tipo

/* Inicializador (`= expr`) para validarlo contra el tipo declarado; si no
 * hay tipo declarado, el tipo se infiere del inicializador. Y `const` es
 * inmutable: exige inicializador y rechaza asignaciones posteriores. */
%init_of var_decl    expr
%init_of const_decl  expr
%immutable const_decl

/* Asignacion a variable suelta, y operadores aritmeticos: con esto el
 * sistema de tipos (src/semantico/types) queda conectado al recorrido, no
 * solo disponible como API. MOD queda fuera a proposito: la tabla de
 * compatibilidad solo cubre + - * / . */
%assign assign_stmt 0 2
%arith PLUS  add
%arith MINUS subtract
%arith TIMES multiply
%arith DIV   divide

/* Operadores logicos, comparaciones y unarios prefijos (fase de `operators`).
 * Igual que %arith, se declaran por TOKEN: el walker reconoce la expresion por
 * su forma (tres hijos con el operador en el medio, o dos con el operador
 * adelante), no por el nombre de la produccion -- asi no hay que enumerar
 * or_expr / and_expr / equality_expr / relational_expr. */
%logic AND and
%logic OR  or

%compare EQ  eq
%compare NEQ neq
%compare LT  lt
%compare LTE lte
%compare GT  gt
%compare GTE gte

/* `unary: MINUS unary | NOT unary | primary` */
%unary NOT   not
%unary MINUS negate

%type_token BOOL_T  bool
%type_token INT_T   integer
%type_token STR_T   string
%type_token TRUE    bool
%type_token FALSE   bool
%type_token INT_LIT integer
%type_token STR_LIT string

/* ------------------------------------------------------------
 * Fase 16 (clases y objetos): this, acceso a miembros con '.',
 * instanciacion con 'new', y la convencion de nombre para el
 * constructor (un metodo normal llamado literalmente "constructor",
 * igual que Compiscript.g4/JS/TS — no una palabra reservada aparte).
 * ------------------------------------------------------------ */
%this THIS
%member_access primary     DOT
%member_access assign_stmt DOT
%new atom NEW 1 3
%call primary LPAREN 0 2
%arg_list_symbol args
%constructor constructor

/* Retorno: que produccion retorna de una funcion, y cual de sus hijos lleva
 * el valor. Se nombra el hijo por SIMBOLO (no por indice) porque
 * `return_stmt: RETURN expr | RETURN` tiene dos alternativas de distinto
 * largo: buscar `expr` no lo encuentra en la segunda, y esa ausencia es
 * justo la senal de "retorno sin valor". */
%return return_stmt expr

%condition if_stmt expr
%condition while_stmt expr
%loop while_stmt
%break break_stmt
%continue continue_stmt

/* do-while y for llevan la condicion por INDICE, no por simbolo: en
 * `do_while_stmt` va despues del cuerpo y en `for_stmt` es el SEGUNDO
 * hijo `expr` (el primero seria el inicializador). Buscar por simbolo
 * devuelve el primero y señalaria el nodo equivocado. */
%condition do_while_stmt 4
%condition for_stmt      4
%loop      do_while_stmt
%loop      for_stmt
%loop      foreach_stmt

/* La variable del for, la del foreach y la del catch viven en un
 * ambito propio: no deben verse despues del bucle ni fuera del catch. */
%scope for_stmt      block
%scope foreach_stmt  block
%scope catch_clause  block
%declare catch_param variable

/* switch: el discriminante NO se exige booleano (un switch se hace
 * sobre un integer o un string); lo que se valida es que el tipo de
 * cada `case` sea compatible con el. Ademas un %switch abre un
 * contexto que permite `break` pero NO `continue`. */
%switch  switch_stmt 2
%case    switch_case 1

/* foreach: produccion, indice de la variable e indice del iterable.
 * La variable se declara con el tipo de ELEMENTO del iterable. */
%foreach foreach_stmt 2 4

/* Codigo muerto: que producciones son una SECUENCIA de sentencias. Lo que
 * corta el flujo NO se declara de nuevo: son las mismas producciones de
 * %return/%break/%continue. Todo lo que siga a una de ellas dentro de la
 * misma secuencia es inalcanzable -> W002, y se deja de analizar. */
%stmt_list stmt_list
%stmt_list case_body

/* Literal de struct: Punto { x: 1, y: 2 }. La produccion se reconoce por la
 * FORMA (que traiga LBRACE como hijo directo), igual que %new y %call. */
%struct_literal atom LBRACE 0 2
%field_list_symbol field_init_list
%field_init field_init 0 2

/* Listas/arreglos: tipo (`tipo: tipo LBRACKET RBRACKET`, marcado por el
 * corchete), literal (`atom: LBRACKET arg_list RBRACKET`, reusa la misma
 * lista separada por comas que args_list_symbol) y acceso indexado
 * (`primary: primary LBRACKET expr RBRACKET`). Multidimensional
 * (`int[][]`) sale gratis de anidar ambas reglas. */
%array_type LBRACKET
%array_literal atom LBRACKET 1
%index primary LBRACKET 0 2

%%

/* ============================================================
 * Punto de entrada: lista de sentencias de nivel superior
 * (Compiscript.g4 permite function/class declaration en cualquier
 * lugar donde vale un statement, no solo al tope — stmt_list se
 * reusa igual dentro de bloque)
 * ============================================================ */

programa:
    stmt_list
;

stmt_list:
    stmt_list stmt
  | stmt
;

stmt:
    var_decl SEMI
  | const_decl SEMI
  | assign_stmt SEMI
  | func_decl
  | class_decl
  | struct_decl
  | print_stmt SEMI
  | bloque
  | if_stmt
  | while_stmt
  | do_while_stmt SEMI
  | for_stmt
  | foreach_stmt
  | switch_stmt
  | try_stmt
  | break_stmt SEMI
  | continue_stmt SEMI
  | return_stmt SEMI
  | expr SEMI
;

/* ============================================================
 * Tipos
 * ============================================================ */

tipo:
    BOOL_T
  | INT_T
  | STR_T
  | ID
  | tipo LBRACKET RBRACKET
;

/* ============================================================
 * let / var — ambas mutables, mismo tratamiento semantico
 * ============================================================ */

let_or_var:
    LET
  | VAR
;

var_decl:
    let_or_var ID
  | let_or_var ID COLON tipo
  | let_or_var ID ASSIGN expr
  | let_or_var ID COLON tipo ASSIGN expr
;

/* ============================================================
 * const — inicializador siempre obligatorio en la gramatica
 * ============================================================ */

const_decl:
    CONST ID ASSIGN expr
  | CONST ID COLON tipo ASSIGN expr
;

/* ============================================================
 * Asignacion: a una variable simple, o a una propiedad de un
 * objeto (this.attr = expr, obj.attr = expr) — calcada de
 * PropertyAssignExpr de Compiscript.g4
 * (lhs=leftHandSide '.' Identifier '=' assignmentExpr).
 * ============================================================ */

assign_stmt:
    ID ASSIGN expr
  | primary DOT ID ASSIGN expr
;

/* ============================================================
 * print / bloque / if / while / return
 * ============================================================ */

print_stmt:
    PRINT LPAREN expr RPAREN
;

bloque:
    LBRACE stmt_list RBRACE
  | LBRACE RBRACE
;

if_stmt:
    IF LPAREN expr RPAREN bloque
  | IF LPAREN expr RPAREN bloque ELSE bloque
  | IF LPAREN expr RPAREN bloque ELSE if_stmt
;

while_stmt:
    WHILE LPAREN expr RPAREN bloque
;

/* ============================================================
 * do-while: la condicion va DESPUES del cuerpo, en el indice 4
 *   do { ... } while (cond);
 * El SEMI final lo pone `stmt`, igual que break/continue/return.
 * ============================================================ */

do_while_stmt:
    DO bloque WHILE LPAREN expr RPAREN
;

/* ============================================================
 * for (init ; cond ; update) — misma forma que miniprog.yalp, que
 * ya compila sin conflictos en este mismo generador. init y update
 * se aislan en no-terminales propios con alternativa vacia, y se
 * reusan `var_decl`/`assign_stmt` para heredar su semantica ya
 * declarada (%declare var_decl, %assign assign_stmt).
 *
 * Desviacion consciente frente a Compiscript.g4: alli la condicion
 * es opcional (`expression?`); aca es obligatoria, para no anidar
 * otro epsilon en una produccion que ya tiene dos.
 * ============================================================ */

for_stmt:
    FOR LPAREN for_init SEMI expr SEMI for_update RPAREN bloque
;

for_init:
    var_decl
  | assign_stmt
  | /* vacio */
;

for_update:
    assign_stmt
  | /* vacio */
;

/* ============================================================
 * foreach (x in coleccion) { ... }
 * La variable esta en el indice 2 y el iterable en el 4; el tipo de
 * `x` sale del tipo de elemento del iterable (ver %foreach).
 * ============================================================ */

foreach_stmt:
    FOREACH LPAREN ID IN expr RPAREN bloque
;

/* ============================================================
 * switch: el cuerpo de cada case es una lista de sentencias SIN
 * llaves, delimitada por el siguiente case/default o por el '}'.
 *
 * Dos desviaciones conscientes frente a Compiscript.g4, las dos para
 * no anidar epsilons que generan conflictos:
 *  - se permiten varios `default` y en cualquier posicion (restringir
 *    a uno solo es una regla semantica, no gramatical);
 *  - `switch_case` y `default_case` son producciones separadas, para
 *    que %case apunte exactamente a la que si lleva expresion.
 * ============================================================ */

switch_stmt:
    SWITCH LPAREN expr RPAREN LBRACE switch_members RBRACE
;

switch_members:
    switch_members switch_member
  | /* vacio */
;

switch_member:
    switch_case
  | default_case
;

switch_case:
    CASE expr COLON case_body
;

default_case:
    DEFAULT COLON case_body
;

case_body:
    case_body stmt
  | /* vacio */
;

/* ============================================================
 * try { ... } catch (e) { ... }
 *
 * `catch_clause` es quien abre el ambito (%scope catch_clause block)
 * y `catch_param` cuelga de el, asi que la variable del catch se
 * declara DENTRO de ese ambito — mismo patron que `param` dentro de
 * `func_decl`. Sin ese nivel intermedio, el ID quedaria declarado en
 * el ambito de afuera.
 * ============================================================ */

try_stmt:
    TRY bloque catch_clause
;

catch_clause:
    CATCH LPAREN catch_param RPAREN bloque
;

catch_param:
    ID
;

break_stmt:
    BREAK
;

continue_stmt:
    CONTINUE
;

return_stmt:
    RETURN expr
  | RETURN
;

/* ============================================================
 * Declaracion de funcion, con tipo de retorno opcional
 *   function nombre(param, ...) [: tipo] { ... }
 * ============================================================ */

func_decl:
    FUNCTION ID LPAREN param_list RPAREN bloque
  | FUNCTION ID LPAREN param_list RPAREN COLON tipo bloque
;

param_list:
    params
  | /* vacio */
;

params:
    params COMMA param
  | param
;

param:
    ID
  | ID COLON tipo
;

/* ============================================================
 * Declaracion de clase, con herencia opcional
 *   class Nombre [: Padre] { miembro* }
 * ============================================================ */

class_decl:
    CLASS ID LBRACE class_members RBRACE
  | CLASS ID COLON ID LBRACE class_members RBRACE
;

class_members:
    class_members class_member
  | /* vacio */
;

class_member:
    func_decl
  | var_decl SEMI
  | const_decl SEMI
;

/* ============================================================
 * Declaracion de struct/record: solo campos tipados, sin
 * metodos, sin herencia y sin constructor.
 *   struct Nombre { campo: tipo; ... }
 * El SEMI de cada campo es OBLIGATORIO: sin el, dos campos
 * seguidos exigirian decidir con un solo token de lookahead.
 * ============================================================ */

struct_decl:
    STRUCT ID LBRACE struct_fields RBRACE
;

struct_fields:
    struct_fields struct_field
  | /* vacio */
;

struct_field:
    ID COLON tipo SEMI
;

/* ============================================================
 * Jerarquia de expresiones (menor a mayor precedencia), calcada de
 * la seccion "Expression Rules" de Compiscript.g4:
 *
 *  or_expr          ||
 *    and_expr         &&
 *      equality_expr    ==  !=
 *        relational_expr  <  <=  >  >=
 *          additive_expr    +  -
 *            term             *  /  %
 *              unary            - unario, !
 *                primary
 *                  atom
 * ============================================================ */

expr:
    or_expr
;

or_expr:
    or_expr OR and_expr
  | and_expr
;

and_expr:
    and_expr AND equality_expr
  | equality_expr
;

equality_expr:
    equality_expr EQ  relational_expr
  | equality_expr NEQ relational_expr
  | relational_expr
;

relational_expr:
    relational_expr LT  additive_expr
  | relational_expr LTE additive_expr
  | relational_expr GT  additive_expr
  | relational_expr GTE additive_expr
  | additive_expr
;

additive_expr:
    additive_expr PLUS  term
  | additive_expr MINUS term
  | term
;

term:
    term TIMES unary
  | term DIV   unary
  | term MOD   unary
  | unary
;

unary:
    MINUS unary
  | NOT unary
  | primary
;

/* ============================================================
 * Primary: atom con sufijos de llamada a funcion y acceso a
 * miembro (solo LECTURA — obj.attr, obj.metodo(), encadenado
 * obj.a.b; asignar con obj.attr = expr queda fuera de este
 * subconjunto, ver comentario de cabecera).
 * ============================================================ */

primary:
    atom
  | primary LPAREN arg_list RPAREN
  | primary DOT ID
  | primary LBRACKET expr RBRACKET
;

atom:
    ID
  | INT_LIT
  | STR_LIT
  | TRUE
  | FALSE
  | NULL_KW
  | THIS
  | NEW ID LPAREN arg_list RPAREN
  | ID LBRACE field_inits RBRACE
  | LPAREN expr RPAREN
  | LBRACKET arg_list RBRACKET
;

/* Literal de struct: Punto { x: 1, y: 2 } */

field_inits:
    field_init_list
  | /* vacio */
;

field_init_list:
    field_init_list COMMA field_init
  | field_init
;

field_init:
    ID COLON expr
;

arg_list:
    args
  | /* vacio */
;

args:
    args COMMA expr
  | expr
;
