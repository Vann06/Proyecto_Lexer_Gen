# API del DBMS (FastAPI). El parser de ANTLR ya viene generado en
# backend/dbms/parser/ (versionado), así que la imagen no necesita Java.
FROM python:3.12-slim
WORKDIR /app

COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./
ENV DBMS_WORKSPACE=/app/workspace
EXPOSE 8080
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8080"]
